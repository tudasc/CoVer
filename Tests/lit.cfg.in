import lit.formats

config.binaries = "@COVER_INSTALLED_BINARIES_DIR@"
config.test_format = lit.formats.ShTest(execute_external=False)
config.suffixes = {".c", ".cpp", ".F90", ".f90"}

config.substitutions += [
    ("%binaries", config.binaries),
    ("%CoVerCC", config.binaries + "/CoVerCC"),
    ("%CoVerCXX", config.binaries + "/CoVerCXX"),
    ("%CoVerFC", config.binaries + ("/CoVerFC" if not "NO_TS29113" in os.environ else "/CoVerFC-no-ts")),
    ("%run_compile", "--predefined-contracts --instrument-contracts %s -o %t.exe 2>&1 | tee %t.test_out"),
    ("%run_dynamic", "env COVER_COVERAGE_FOLDER='%t_coverage' mpiexec -np 2 %t.exe >> %t.test_out 2>&1 || true && FileCheck %s < %t.test_out"),
]

if @COVER_STDCXX_ENABLED@:
    config.substitutions += [
        ("%CoVerStdCXX", "env OMPI_CXX=g++ MPICH_CXX=g++ " + config.binaries + "/CoVerStdCXX "
            "--contract-file=@COVER_INSTALLED_INCLUDE_DIR@/mpi_contracts.h "
            "--wrap-target-gcc=mpicxx --temp-path=%t_stdcxx_tmp -I@MPI_C_HEADER_DIR@"),
        ("%run_stdcxx_compile", "%s -o %t_stdcxx.exe 2>&1 | tee %t_stdcxx.test_out"),
        ("%run_stdcxx_dynamic", "mpiexec -np 2 %t_stdcxx.exe >> %t_stdcxx.test_out 2>&1 || true && FileCheck %s --check-prefix=STDCXX < %t_stdcxx.test_out"),
    ]
else:
    config.substitutions += [
        ("%CoVerStdCXX", ":"),
        ("%run_stdcxx_compile", ""),
        ("%run_stdcxx_dynamic", ":"),
    ]

config.environment["OMPI_CC"] = "clang"
config.environment["OMPI_CXX"] = "clang++"
config.environment["OMPI_FC"] = "flang"

for var in ['OMPI_CC', 'OMPI_CXX', 'OMPI_FC', 'MPICH_CC', 'MPICH_CXX', 'MPICH_FC',
            'COVER_WRAP_TARGET_mpicc', 'COVER_WRAP_TARGET_mpicxx', 'COVER_WRAP_TARGET_mpifort',
            'OMPI_ALLOW_RUN_AS_ROOT', 'OMPI_ALLOW_RUN_AS_ROOT_CONFIRM']: # For Docker testing
    if var in os.environ: config.environment[var] = os.environ[var]

config.name = "test-suite"
